    { "id": "e2", "from": { "node": "noise", "port": "out" }, "to": { "node": "mix", "port": "b" } },
    { "id": "e3", "from": { "node": "mix",   "port": "out" }, "to": { "node": "psd", "port": "in" } }
  ],
  "observation_points": [
    { "id": "s4", "node": "mix", "port": "out", "products": ["spectrum", "envelope"], "label": "S4 观测点" }
  ],
