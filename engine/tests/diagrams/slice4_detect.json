{
  "schema_version": "cuav-diagram/1",
  "diagram_id": "slice4-detect",
  "name": "单音突发加噪声到能量检测（sliding）",
  "nodes": [
    { "id": "tone",  "type": "ToneSource",  "params": { "sample_rate_Hz": 1e6, "center_frequency_Hz": 2.44e9, "offset_Hz": 50e3, "level_dBm": -100, "start_sample": 512000 } },
    { "id": "noise", "type": "NoiseSource", "params": { "sample_rate_Hz": 1e6, "center_frequency_Hz": 2.44e9, "power_dBm": -104 } },
    { "id": "mix",   "type": "AddMixer",    "params": {} },
    { "id": "det",   "type": "EnergyDetector", "params": { "nfft": 256, "band_lo_Hz": -100e3, "band_hi_Hz": 100e3, "pfa": 1e-3, "noise_mode": "sliding", "noise_window_frames": 256 } },
    { "id": "sink",  "type": "DetectionSink", "params": {} }
  ],
  "edges": [
    { "id": "e1", "from": { "node": "tone",  "port": "out" }, "to": { "node": "mix", "port": "a" } },
    { "id": "e2", "from": { "node": "noise", "port": "out" }, "to": { "node": "mix", "port": "b" } },
    { "id": "e3", "from": { "node": "mix",   "port": "out" }, "to": { "node": "det", "port": "in" } },
    { "id": "e4", "from": { "node": "det",   "port": "out" }, "to": { "node": "sink", "port": "in" } }
  ],
  "observation_points": [
    { "id": "s4", "node": "mix", "port": "out", "products": ["envelope"], "label": "S4 观测点" }
  ],
  "run": { "seed": 20260912, "duration_s": 2.0, "time_basis": "LogicalSim" }
}
