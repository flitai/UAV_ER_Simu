{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUAV diagram (cuav-diagram/1)",
  "description": "框图文件。字段冻结见 docs/diagram-format.md。未知键一律拒绝。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_id", "name", "nodes", "edges", "run"],
  "properties": {
    "schema_version": { "const": "cuav-diagram/1" },
    "diagram_id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "observation_points": { "type": "array", "items": { "$ref": "#/$defs/observation_point" } },
    "run": { "$ref": "#/$defs/run" },
    "scenario_ref": { "$ref": "#/$defs/scenario_ref" },
    "trace": { "$ref": "#/$defs/trace" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
    "port_name": { "type": "string", "pattern": "^[a-z0-9_:-]{1,64}$" },
    "param_value": { "type": ["number", "string", "boolean"] },
    "port_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "port"],
      "properties": { "node": { "$ref": "#/$defs/id" }, "port": { "$ref": "#/$defs/port_name" } }
    },
    "scene_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/id" },
        "entity_id": { "$ref": "#/$defs/id" },
        "site_id": { "$ref": "#/$defs/id" }
      },
      "oneOf": [ { "required": ["entity_id"] }, { "required": ["site_id"] } ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
        "label": { "type": "string", "maxLength": 200 },
        "params": { "type": "object", "additionalProperties": { "$ref": "#/$defs/param_value" } },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
        },
        "scene_binding": { "$ref": "#/$defs/scene_binding" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/port_ref" },
        "to": { "$ref": "#/$defs/port_ref" }
      }
    },
    "observation_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node", "port", "products"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "node": { "$ref": "#/$defs/id" },
        "port": { "$ref": "#/$defs/port_name" },
        "products": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["spectrum", "envelope", "iq"] }
        },
        "label": { "type": "string", "maxLength": 200 },
        "params": { "type": "object", "additionalProperties": { "$ref": "#/$defs/param_value" } }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "duration_s", "time_basis"],
      "properties": {
        "seed": { "type": "integer", "minimum": 0 },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "block_size": { "type": "integer", "minimum": 1 },
        "time_basis": { "const": "LogicalSim" },
        "max_rounds": { "type": "integer", "minimum": 1 }
      }
    },
    "scenario_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "sha256"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/id" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "parent_diagram_id": { "$ref": "#/$defs/id" },
        "notes": { "type": "string" }
      }
    }
  }
}
