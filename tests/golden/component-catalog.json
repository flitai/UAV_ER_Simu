        {
          "default": "fixed",
          "description": "视轴指向：固定方位，或跟随平台航向（只对 role = tx 有意义）",
          "enum": [
            "fixed",
            "heading"
          ],
          "name": "pointing",
          "required": false,
          "type": "enum",
          "unit": ""
        },
        {
          "default": 0.0,
          "description": "视轴方位，真北顺时针",
          "max": 360.0,
          "max_exclusive": true,
          "min": 0.0,
          "name": "boresight_az_deg",
          "required": false,
          "type": "number",
          "unit": "deg"
        },
        {
          "default": 0.0,
          "description": "视轴俯仰，水平为 0",
          "max": 90.0,
          "min": -90.0,
          "name": "boresight_el_deg",
          "required": false,
          "type": "number",
          "unit": "deg"
        },
        {
          "default": "vertical",
          "description": "本天线极化",
          "enum": [
            "vertical",
            "horizontal",
            "slant45",
            "rhcp",
            "lhcp"
          ],
          "name": "polarization",
          "required": false,
          "type": "enum",
          "unit": ""
        },
        {
          "default": "vertical",
