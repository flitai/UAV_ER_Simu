          "description": "峰值增益",
          "max": 40.0,
          "min": -10.0,
          "name": "gain_dBi",
          "required": true,
          "type": "number",
          "unit": "dBi"
        },
        {
          "default": 60.0,
          "description": "方位半功率波束宽度，仅 directional",
